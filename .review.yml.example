# .review.yml — AI Commit Review Bot Configuration
# Place this file in your repository root

review:
  language: zh              # zh | en
  max_diff_lines: 500
  auto_approve: false
  incremental: true         # Only review new changes since last review

model:
  fallback: deepseek-chat   # Fallback model if primary fails

severity:
  block_threshold: error    # error and above will block merging
  inline_threshold: warning # warning and above will get inline comments

# Language/framework specific rules
language_rules:
  - pattern: "*.py"
    prompt: "重点关注类型提示、f-string 安全、GIL 并发问题"
  - pattern: "*.go"
    prompt: "重点关注 goroutine 泄露、error 处理"
  - pattern: "*.java"
    prompt: "重点关注 NPE、线程安全、资源关闭"
  - pattern: "*.sql"
    prompt: "重点关注 SQL 注入、索引使用、性能"

# Webhook notifications
webhooks:
  - type: dingtalk
    url: https://oapi.dingtalk.com/robot/send?access_token=xxx
  - type: wecom
    url: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
  - type: slack
    url: https://hooks.slack.com/services/xxx
  - type: feishu
    url: https://open.feishu.cn/open-apis/bot/v2/hook/xxx
  - type: generic
    url: https://your-server.com/webhook
    secret: optional-hmac-secret

# PR auto-labeling
labels:
  enabled: true
  prefix: ai-review

# Custom review prompt
custom_prompt: |
  重点关注安全漏洞和性能问题

# Ignore patterns (files/paths to always skip)
ignore:
  - "docs/"
  - "*.md"
  - "test/fixtures/"

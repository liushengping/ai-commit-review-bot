{
  "name": "ai-commit-review-bot",
  "version": "3.0.0",
  "description": "AI-powered code review bot for GitHub, GitLab, Bitbucket, Gitea. Supports MiMo, Claude, GPT and more.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test src/__tests__/*.test.js",
    "test:core": "node --test src/__tests__/core.test.js",
    "test:platforms": "node --test src/__tests__/platforms.test.js"
  },
  "keywords": [
    "code-review",
    "ai",
    "mimo",
    "llm",
    "github-action",
    "gitlab-ci",
    "gitea",
    "bitbucket",
    "pull-request",
    "merge-request"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "@octokit/rest": "^20.0.0"
  }
}
